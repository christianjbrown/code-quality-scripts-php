#!/usr/bin/env php
<?php

declare(strict_types=1);

// Fails a pull request whose changelog is missing or out of step with its code changes.
// Usage: php-changelog-check <base-ref>, run from the repository root, e.g. origin/main.

use ChristianBrown\CodeQualityScripts\Changelog\ChangelogCheck;
use ChristianBrown\CodeQualityScripts\Changelog\EntryRule;
use ChristianBrown\CodeQualityScripts\Changelog\GitChangedFilesProvider;
use ChristianBrown\CodeQualityScripts\Changelog\UnreleasedSectionRule;
use ChristianBrown\CodeQualityScripts\Console\FileReader;
use ChristianBrown\CodeQualityScripts\Console\StreamResultReporter;

require $GLOBALS['_composer_autoload_path'] ?? __DIR__.'/../vendor/autoload.php';

$baseRef = $argv[1] ?? '';
if ('' === $baseRef) {
    fwrite(STDERR, "Usage: php-changelog-check <base-ref>\n");

    exit(2);
}

$check = new ChangelogCheck(
    [new EntryRule(), new UnreleasedSectionRule()],
    new GitChangedFilesProvider((string) getcwd()),
    new FileReader(),
);

exit((new StreamResultReporter(STDOUT, STDERR))->report($check->check($baseRef)));
