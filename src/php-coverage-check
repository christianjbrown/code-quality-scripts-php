#!/usr/bin/env php
<?php

declare(strict_types=1);

// Fails the build when any metric in a PHPUnit --coverage-text report is under the floor.
// Usage: php-coverage-check <report-file> [minimum-percent, default 100]

use ChristianBrown\CodeQualityScripts\Console\FileReader;
use ChristianBrown\CodeQualityScripts\Console\StreamResultReporter;
use ChristianBrown\CodeQualityScripts\Coverage\CoverageCheck;
use ChristianBrown\CodeQualityScripts\Coverage\SummaryParser;
use ChristianBrown\CodeQualityScripts\Coverage\ThresholdChecker;

require $GLOBALS['_composer_autoload_path'] ?? __DIR__.'/../vendor/autoload.php';

$check = new CoverageCheck(new FileReader(), new SummaryParser(), new ThresholdChecker());

exit((new StreamResultReporter(STDOUT, STDERR))->report(
    $check->check($argv[1] ?? '', (float) ($argv[2] ?? 100)),
));
